function zsh-paste() {
  LBUFFER+=$(wl-paste --no-newline)
}
zle -N zsh-paste
bindkey "\e[1084;6u" zsh-paste
function zsh-copy() {
  echo -n "$BUFFER" | wl-copy
}
zle -N zsh-copy
bindkey "\e[1089;6u" zsh-copy





# Set-up FZF key bindings (CTRL R for fuzzy history finder)
# fzf: fd-based file lists, previews for Ctrl+T / Alt+C, colours from the terminal's ANSI palette
# (caelestia recolours the palette, so fzf follows the scheme)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
export FZF_DEFAULT_OPTS="--height=50% --layout=reverse --border=rounded --info=inline-right \
  --color=fg:7,bg:-1,hl:6,fg+:15,bg+:8,hl+:14,info:3,prompt:2,pointer:5,marker:2,spinner:5,header:4,border:8"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}' --preview-window=right:55%"
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons --color=always {}'"
source <(fzf --zsh)
# fzf --zsh rebinds Tab to fzf-completion; give it back to fzf-tab
(( $+functions[enable-fzf-tab] )) && enable-fzf-tab

HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt append_history share_history extended_history
setopt hist_ignore_dups hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt auto_pushd pushd_ignore_dups interactive_comments

# fzf-tab: previews and group switching
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'lsd -1 --color=always $realpath'
zstyle ':fzf-tab:complete:z:*' fzf-preview 'lsd -1 --color=always $realpath'
zstyle ':fzf-tab:*' switch-group '<' '>'

# Set-up icons for files/directories in terminal using lsd
if command -v eza >/dev/null; then
    alias ls='eza --icons --group-directories-first'
    alias l='ls -l --git'
    alias la='ls -a'
    alias lla='ls -la --git'
    alias lt='ls --tree --level=2'
else
    alias ls='lsd'
    alias l='ls -l'
    alias la='ls -a'
    alias lla='ls -la'
    alias lt='ls --tree'
fi
alias cat='bat -pp'
