# starship prompt
command -v starship >/dev/null && eval "$(starship init zsh)"

# transient prompt: collapse the finished prompt to `dir ❯` so scrollback stays compact.
# starship sets PROMPT once at init, so keep the originals and restore them before every prompt.
if command -v starship >/dev/null; then
    _full_prompt=$PROMPT
    _full_rprompt=$RPROMPT
    _transient_accept_line() {
        # empty Enter keeps the full prompt instead of stacking bare `❯` lines
        if [[ -n $BUFFER ]]; then
            PROMPT='%F{cyan}%1~%f %F{green}❯%f '
            RPROMPT=''
            zle .reset-prompt
        fi
        zle .accept-line
    }
    zle -N accept-line _transient_accept_line
    _restore_full_prompt() { PROMPT=$_full_prompt; RPROMPT=$_full_rprompt }
    add-zsh-hook precmd _restore_full_prompt
fi

# direnv: auto-load .envrc / venv on cd
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# zoxide must be initialised last (its doctor warns otherwise)
eval "$(zoxide init zsh)"
