{
  "paths": {
    "wallpaperDir": "~/Pictures/wallpapers",
    "sessionGif": "~/.config/caelestia/session.webp"
  },
  "session": {
    "commands": {
      "logout": [
        "hyprctl",
        "dispatch",
        "hl.dsp.exit()"
      ],
      "shutdown": [
        "systemctl",
        "poweroff"
      ],
      "hibernate": [
        "systemctl",
        "hibernate"
      ],
      "reboot": [
        "systemctl",
        "reboot"
      ]
    }
  },
  "launcher": {
    "favouriteApps": [
      "org.mozilla.firefox",
      "org.telegram.desktop",
      "com.microsoft.VSCode"
    ]
  },
  "general": {
    "apps": {
      "terminal": [
        "ghostty",
        "+new-window",
        "-e"
      ],
      "explorer": [
        "dolphin"
      ],
      "audio": [
        "pavucontrol"
      ]
    },
    "idle": {
      "lockBeforeSleep": true,
      "inhibitWhenAudio": true,
      "inhibitWhenCharging": false,
      "timeouts": [
        {
          "timeout": 540,
          "idleAction": [
            "brightnessctl",
            "-s",
            "set",
            "15%"
          ],
          "returnAction": [
            "brightnessctl",
            "-r"
          ],
          "respectInhibitors": true
        },
        {
          "timeout": 600,
          "idleAction": "lock",
          "respectInhibitors": true
        },
        {
          "timeout": 900,
          "idleAction": "dpms off",
          "returnAction": "dpms on",
          "respectInhibitors": true
        },
        {
          "timeout": 1800,
          "idleAction": [
            "systemctl",
            "suspend"
          ],
          "respectInhibitors": true,
          "inhibitWhenCharging": true
        }
      ]
    }
  },
  "services": {
    "weatherLocation": "55.1644,61.4368",
    "weatherUnits": "Celsius",
    "clockFormat": "TwentyFourHour"
  },
