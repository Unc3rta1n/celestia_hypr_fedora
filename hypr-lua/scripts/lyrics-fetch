#!/usr/bin/env bash
# Background lyrics fetcher: on every track change, if ~/Music/Lyrics has no "<Artist> - <Title>.lrc"
# (the name caelestia's local backend looks for), fetch synced lyrics and tell the shell to reload
# (patches/0009) via syncedlyrics: LRCLIB / NetEase / Megalobiz. Musixmatch is left out: its
# desktop API answers unofficial clients with decoy lyrics. Started once from lua/autostart.lua.
set -uo pipefail

DIR=${LYRICS_DIR:-$HOME/Music/Lyrics}
MISS=${XDG_CACHE_HOME:-$HOME/.cache}/lyrics-fetch.miss # tracks nothing was found for: don't retry
mkdir -p "$DIR" "$(dirname "$MISS")"
touch "$MISS"

has_lrc() { grep -qE '^\[[0-9]+:[0-9]+' "$1" 2>/dev/null; }

fetch() { # artist title
    local artist=$1 title=$2 key file tmp
    key="$artist - $title"
    file="$DIR/${artist//\//_} - ${title//\//_}.lrc"
    [[ -s $file ]] && return
    grep -qxF "$key" "$MISS" && return

    tmp=$(mktemp --suffix=.lrc)
    if command -v syncedlyrics >/dev/null &&
        timeout 30 syncedlyrics "$artist $title" -p lrclib netease megalobiz --synced-only -o "$tmp" >/dev/null 2>&1 &&
        has_lrc "$tmp"; then
        :
    else
        rm -f "$tmp"
        echo "$key" >>"$MISS"
        return
    fi
    mv "$tmp" "$file"
    qs -c caelestia ipc call lyrics refresh >/dev/null 2>&1
}

last=""
playerctl -a --follow metadata --format $'{{artist}}\t{{title}}' 2>/dev/null |
    while IFS=$'\t' read -r artist title; do
        [[ -n $artist && -n $title && "$artist$title" != "$last" ]] || continue
        last="$artist$title"
        fetch "$artist" "$title" &
    done
