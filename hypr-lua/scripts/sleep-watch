#!/usr/bin/env bash
# Before suspend: disable the monitors wired to the NVIDIA dGPU (HDMI on this laptop).
# After resume:   `hyprctl reload` brings them back from monitors.lua, then force a repaint.
# Suspending with an active NVIDIA output froze the session on resume
# ("nvidia-drm: Flip event timeout on head 0"): the caelestia lock stayed on its first frame
# and nothing reacted. With no NVIDIA output during sleep there is nothing to flip on resume.
# Telegram (Qt) keeps a buffer of the wrong orientation after its rotated monitor comes back;
# pulling it through the Super+` scratchpad and back makes Hyprland resend size and transform.
# Started once from lua/autostart.lua (inherits HYPRLAND_INSTANCE_SIGNATURE).
set -uo pipefail

log=/tmp/sleep-watch.log
inhibitor=
disabled=0
off_outputs=()

log() { echo "$(date +%T.%3N) $*" >>"$log"; }

hc() { # hyprctl with a timeout: a hung Hyprland must not hang this script too
    local rc
    timeout 5 hyprctl "$@" >/dev/null
    rc=$?
    log "hyprctl $1 rc=$rc"
    return $rc
}

hold_sleep() { # delay lock: logind waits (InhibitDelayMaxSec, 5 s) until we release it
    systemd-inhibit --what=sleep --mode=delay --who=sleep-watch \
        --why="Disable NVIDIA outputs before sleep" sleep infinity &
    inhibitor=$!
}

nvidia_outputs() { # connected connectors of the NVIDIA card, e.g. HDMI-A-1
    local c name
    for c in /sys/class/drm/card*-*; do
        [[ $(<"$c/status") == connected ]] || continue
        [[ $(basename "$(readlink -f "$c/device/device/driver")") == nvidia ]] || continue
        name=${c##*/}
        echo "${name#card*-}"
    done
}

before_sleep() {
    local out
    disabled=0
    off_outputs=()
    log "before_sleep: nvidia outputs: $(nvidia_outputs | tr '\n' ' ')"
    for out in $(nvidia_outputs); do
        hc eval "hl.monitor({ output = \"$out\", disabled = true })" && { disabled=1; off_outputs+=("$out"); }
    done
    log "before_sleep: done disabled=$disabled"
}

nudge_telegram() { # re-pull Telegram if it sits on a monitor that was disabled during sleep
    local mon out id
    mon=$(timeout 5 hyprctl clients -j | jq -r '.[] | select(.class == "org.telegram.desktop"
        and (.workspace.name | startswith("special") | not)) | .monitor') || return 0
    [[ -n $mon ]] || return 0
    for out in "${off_outputs[@]}"; do
        id=$(timeout 5 hyprctl monitors -j | jq -r --arg o "$out" '.[] | select(.name == $o) | .id')
        [[ $id == "$mon" ]] || continue
        log "nudge_telegram: on $out"
        hc eval 'require("lua.scratchpad").toggle()'
        sleep 0.4
        hc eval 'require("lua.scratchpad").toggle()'
        return 0
    done
}

after_resume() {
    log "after_resume: start"
    # nvidia-resume.service runs after logind reports the wake-up; let it finish first
    while systemctl list-jobs --no-legend 2>/dev/null | grep -q nvidia-resume; do sleep 0.5; done
    log "after_resume: nvidia-resume finished"
    sleep 1
    log "after_resume: connected now: $(for c in /sys/class/drm/card*-*; do [[ $(<"$c/status") == connected ]] && printf '%s ' "${c##*/}"; done)"
    ((disabled)) && hc reload
    # Hyprland doesn't repaint after resume until some input: the lock stays on its first frame
    hc eval 'hl.dispatch(hl.dsp.force_renderer_reload())'
    nudge_telegram
    log "after_resume: done"
}

hold_sleep
while read -r line; do
    case $line in
    *"PrepareForSleep (true,)"*)
        log "PrepareForSleep true"
        before_sleep
        kill "$inhibitor" 2>/dev/null
        ;;
    *"PrepareForSleep (false,)"*)
        log "PrepareForSleep false"
        hold_sleep
        after_resume
        ;;
    esac
done < <(gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1)
