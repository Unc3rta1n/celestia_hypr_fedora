#!/usr/bin/env bash
# hyprdsp DISPATCHER ARGS — drop-in for legacy `hyprctl dispatch DISPATCHER ARGS` under the Lua config.
# Covers the dispatchers used by KoolDots scripts; anything else is passed through unchanged
# (so already-Lua calls like `hyprdsp 'hl.dsp.exit()'` keep working).
set -euo pipefail

d=${1:?usage: hyprdsp DISPATCHER [ARGS]}
shift
arg="$*"

q() { if [[ $1 =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then printf '%s' "$1"; else printf '[==[%s]==]' "$1"; fi; }

# "exact X Y,address:0x.." -> x, y, relative, window
split_window() { # sets PAYLOAD / WIN from "payload,window"
    if [[ $1 == *,* ]]; then PAYLOAD=${1%%,*}; WIN=${1#*,}; else PAYLOAD=$1; WIN=""; fi
}
win_field() { [[ -n ${WIN:-} ]] && printf ', window = %s' "$(q "$WIN")" || true; }

xy_call() { # $1 = hl.dsp.window.move / resize
    split_window "$arg"
    local rel=true p=$PAYLOAD
    if [[ $p == exact\ * ]]; then rel=false; p=${p#exact }; fi
    read -r x y <<<"$p"
    printf '%s({ x = %s, y = %s, relative = %s%s })' "$1" "$(q "$x")" "$(q "$y")" "$rel" "$(win_field)"
}

exec_rules() { # "[float; size 800 600; workspace special:x silent] cmd"
    local rules="" cmd=$arg
    if [[ $arg =~ ^\[([^]]*)\][[:space:]]*(.*)$ ]]; then
        cmd=${BASH_REMATCH[2]}
        local IFS=';' r
        for r in ${BASH_REMATCH[1]}; do
            r=$(sed 's/^ *//; s/ *$//' <<<"$r")
            [[ -z $r ]] && continue
            local k=${r%% *} v=""
            [[ $r == *" "* ]] && v=${r#* }
            case $k in
            size | move) IFS=" " read -r a b <<<"$v"; rules+="$k = { $(q "$a"), $(q "$b") }, " ;;
            *) if [[ -z $v ]]; then rules+="$k = true, "; else rules+="$k = $(q "$v"), "; fi ;;
            esac
        done
    fi
    if [[ -n $rules ]]; then
        printf 'hl.dsp.exec_cmd(%s, { %s})' "$(q "$cmd")" "$rules"
    else
        printf 'hl.dsp.exec_cmd(%s)' "$(q "$cmd")"
    fi
}

case $d in
hl.dsp.* | *"("*) lua="$d${arg:+ $arg}" ;;
exec) lua=$(exec_rules) ;;
movewindowpixel) lua=$(xy_call hl.dsp.window.move) ;;
resizewindowpixel) lua=$(xy_call hl.dsp.window.resize) ;;
pin) WIN=$arg; lua="hl.dsp.window.pin({ action = \"toggle\"$(win_field) })" ;;
togglefloating) WIN=$arg; lua="hl.dsp.window.float({ action = \"toggle\"$(win_field) })" ;;
focuswindow) lua="hl.dsp.focus({ window = $(q "$arg") })" ;;
workspace) lua="hl.dsp.focus({ workspace = $(q "$arg") })" ;;
movetoworkspace | movetoworkspacesilent)
    split_window "$arg"
    follow=true; [[ $d == movetoworkspacesilent ]] && follow=false
    lua="hl.dsp.window.move({ workspace = $(q "$PAYLOAD"), follow = $follow$(win_field) })" ;;
moveworkspacetomonitor)
    read -r ws mon <<<"$arg"
    lua="hl.dsp.workspace.move({ workspace = $(q "$ws"), monitor = $(q "$mon") })" ;;
sendshortcut) # "CTRL SHIFT, V, activewindow"
    IFS=',' read -r mods key win <<<"$arg"
    WIN=$(xargs <<<"${win:-}"); [[ $WIN == activewindow ]] && WIN=""
    lua="hl.dsp.send_shortcut({ mods = $(q "$(xargs <<<"$mods")"), key = $(q "$(xargs <<<"$key")")$(win_field) })" ;;
dpms | dpmsoff | dpmson)
    case "$d $arg" in *off*) act=disable ;; *on*) act=enable ;; *) act=toggle ;; esac
    lua="hl.dsp.dpms({ action = \"$act\" })" ;;
killactive) lua="hl.dsp.window.close()" ;;
exit) lua="hl.dsp.exit()" ;;
*) echo "hyprdsp: unsupported legacy dispatcher '$d'" >&2; exit 2 ;;
esac

[[ -n ${HYPR_DRY:-} ]] && { echo "$lua"; exit 0; }
exec hyprctl dispatch "$lua"
