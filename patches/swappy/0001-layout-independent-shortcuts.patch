+/* Non-latin layouts (e.g. ru): map the physical key to the keyval of the first
+ * layout so shortcuts like Ctrl+Z work regardless of the active layout. */
+static guint layout_independent_keyval(GdkEventKey *event) {
+  guint keyval = event->keyval;
+  if (gdk_keyval_to_unicode(keyval) <= 0x7f) {
+    return keyval;
+  }
+  GdkKeymap *keymap = gdk_keymap_get_for_display(gdk_display_get_default());
+  guint translated;
+  if (gdk_keymap_translate_keyboard_state(keymap, event->hardware_keycode,
+                                          event->state, 0, &translated, NULL,
+                                          NULL, NULL)) {
+    return translated;
+  }
+  return keyval;
+}
