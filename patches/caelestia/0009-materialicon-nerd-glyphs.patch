+        family: "JetBrainsMono Nerd Font Propo",
+        pointSize: fontStyle.pointSize
+    }) : Tokens.font.icon.size(fontStyle.pointSize).weight(fontStyle.weight).vaxes(fontStyle.variableAxes).fill(fill.toFixed(1)).grade(grade).build()
 }
