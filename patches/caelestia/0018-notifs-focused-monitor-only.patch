 Item {
     id: root
 
+    required property ShellScreen screen
     required property ScreenState screenState
     required property Item osdPanel
     required property Item sessionPanel
@@ -21,6 +22,20 @@ Item {
     readonly property int padding: Tokens.padding.large
     readonly property int clampedPadding: CUtils.clamp(padding - Config.border.thickness, 0, padding)
 
+    // Each popup belongs to the monitor focused when it appeared (no copies on every screen,
+    // no jumping when focus moves while it is shown). Lists are only appended to, never reassigned.
+    property var seenPopups: []
+    property var ownPopups: []
+
+    function isOwn(notif: NotifData): bool {
+        if (!seenPopups.includes(notif)) {
+            seenPopups.push(notif);
+            if (Hypr.focusedMonitor?.name === screen?.name)
+                ownPopups.push(notif);
+        }
+        return ownPopups.includes(notif);
+    }
+
     anchors.top: parent.top
     anchors.bottom: parent.bottom
     anchors.right: parent.right
@@ -69,7 +84,7 @@ Item {
             id: list
 
             model: ScriptModel {
-                values: Notifs.popups.filter(n => !n.closed)
+                values: Notifs.popups.filter(n => !n.closed && root.isOwn(n))
             }
 
             anchors.fill: parent
