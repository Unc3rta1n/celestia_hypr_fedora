     }
 
+    // keybinds go through the shell so its state (elapsed time, paused) stays right:
+    //   qs -c caelestia ipc call recorder toggle "-r -c"   start with these `caelestia record` args, or stop
+    IpcHandler {
+        function toggle(args: string): void {
+            root.needsStop = true;
+            root.needsStart = true;
+            root.startArgs = args.split(" ").filter(a => a);
+            checkProc.running = true;
+        }
+
+        function pause(): void {
+            root.togglePause();
+        }
+
+        target: "recorder"
+    }
+
