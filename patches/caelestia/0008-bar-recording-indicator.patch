diff --git a/modules/bar/components/RecordingEntry.qml b/modules/bar/components/RecordingEntry.qml
new file mode 100644
index 00000000..0e8d949a
--- /dev/null
+++ b/modules/bar/components/RecordingEntry.qml
@@ -0,0 +1,91 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import Caelestia.Config
+import qs.components
+import qs.components.controls
+import qs.services
+
+// Bar entry "recording": blinking REC dot, elapsed time, pause/resume and stop.
+// The wrapper in Bar.qml hides it while nothing is recording.
+StyledRect {
+    id: root
+
+    readonly property int padding: Tokens.padding.small
+
+    implicitWidth: Tokens.sizes.bar.innerWidth
+    implicitHeight: layout.implicitHeight + root.padding * 2
+
+    color: Qt.alpha(Recorder.paused ? Colours.palette.m3tertiaryContainer : Colours.palette.m3errorContainer, 0.9)
+    radius: Tokens.rounding.full
+
+    // keeps Recorder polling pidof, so recordings started from a keybind/CLI show up too
+    Component.onCompleted: Recorder.refCount++
+    Component.onDestruction: Recorder.refCount--
+
+    ColumnLayout {
+        id: layout
+
+        anchors.centerIn: parent
+        spacing: Tokens.spacing.extraSmall
+
+        MaterialIcon {
+            Layout.alignment: Qt.AlignHCenter
+            text: Recorder.paused ? "pause_circle" : "radio_button_checked"
+            color: Recorder.paused ? Colours.palette.m3onTertiaryContainer : Colours.palette.m3error
+            fill: 1
+
+            SequentialAnimation on opacity {
+                running: Recorder.running && !Recorder.paused
+                alwaysRunToEnd: true
+                loops: Animation.Infinite
+
+                Anim {
+                    from: 1
+                    to: 0.2
+                    duration: Tokens.anim.durations.extraLarge
+                }
+                Anim {
+                    from: 0.2
+                    to: 1
+                    duration: Tokens.anim.durations.extraLarge
+                }
+            }
+        }
+
+        StyledText {
+            Layout.alignment: Qt.AlignHCenter
+            text: {
+                const e = Recorder.elapsed;
+                const h = Math.floor(e / 3600);
+                const m = Math.floor((e % 3600) / 60);
+                const s = Math.floor(e % 60).toString().padStart(2, "0");
+                return h > 0 ? `${h}:${m.toString().padStart(2, "0")}\n${s}` : `${m}:${s}`;
+            }
+            horizontalAlignment: Text.AlignHCenter
+            font: Tokens.font.mono.small
+            color: Recorder.paused ? Colours.palette.m3onTertiaryContainer : Colours.palette.m3onErrorContainer
+        }
+
+        IconButton {
+            Layout.alignment: Qt.AlignHCenter
+            type: IconButton.Text
+            isRound: true
+            inactiveOnColour: Recorder.paused ? Colours.palette.m3onTertiaryContainer : Colours.palette.m3onErrorContainer
+            icon: Recorder.paused ? "play_arrow" : "pause"
+            font: Tokens.font.icon.small
+            onClicked: Recorder.togglePause()
+        }
+
+        IconButton {
+            Layout.alignment: Qt.AlignHCenter
+            type: IconButton.Text
+            isRound: true
+            inactiveOnColour: Recorder.paused ? Colours.palette.m3onTertiaryContainer : Colours.palette.m3onErrorContainer
+            icon: "stop"
+            font: Tokens.font.icon.small
+            onClicked: Recorder.stop()
+        }
+    }
+}
diff --git a/services/Recorder.qml b/services/Recorder.qml
