+    // Lyrics from the Yandex Music catalogue: /supplement needs no auth (unlike /lyrics, which wants a signature).
+    property var lyricsByKey: ({}) // "artist|title" -> text, "" = not found, null = lookup running
+    property int lyricsRevision: 0
+
+    function lookupLyrics(key: string, artist: string, title: string): void {
+        lyricsByKey[key] = null;
+        const norm = s => s.toLowerCase().replace(/ё/g, "е").trim();
+        const finish = text => {
+            lyricsByKey[key] = text;
+            lyricsRevision++;
+        };
+        const get = (url, cb) => {
+            const xhr = new XMLHttpRequest();
+            xhr.onreadystatechange = () => {
+                if (xhr.readyState !== XMLHttpRequest.DONE)
+                    return;
+                try {
+                    cb(JSON.parse(xhr.responseText).result);
+                } catch (e) {
+                    finish("");
+                }
+            };
+            xhr.open("GET", url);
+            xhr.send();
+        };
+        get(`https://api.music.yandex.net/search?type=track&page=0&text=${encodeURIComponent(`${artist} ${title}`)}`, res => {
+            const wantArtist = norm(artist);
+            const match = (res?.tracks?.results ?? []).find(t => norm(t.title) === norm(title) && t.artists?.some(a => wantArtist.includes(norm(a.name))));
+            if (!match)
+                return finish("");
+            get(`https://api.music.yandex.net/tracks/${match.id}/supplement`, sup => finish(sup?.lyrics?.fullLyrics ?? ""));
+        });
+    }
+
+    // undefined while loading, "" when the catalogue has no lyrics for the track
+    function getLyrics(player: MprisPlayer): var {
+        lyricsRevision; // re-evaluate bindings when a lookup finishes
+        if (!player?.trackArtist || !player?.trackTitle)
+            return "";
+        const key = `${player.trackArtist}|${player.trackTitle}`;
+        if (!(key in lyricsByKey))
+            lookupLyrics(key, player.trackArtist, player.trackTitle);
+        return lyricsByKey[key] ?? undefined;
+    }
