diff --git a/modules/bar/popouts/MediaPopout.qml b/modules/bar/popouts/MediaPopout.qml
new file mode 100644
index 00000000..92fa215e
--- /dev/null
+++ b/modules/bar/popouts/MediaPopout.qml
@@ -0,0 +1,126 @@
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import Caelestia.Components
+import Caelestia.Config
+import Caelestia.I18n
+import qs.components
+import qs.components.controls
+import qs.components.widgets
+import qs.services
+
+// Popout for the bar "media" entry: cover, title / artist, position and prev / play-pause / next.
+Item {
+    id: root
+
+    required property PopoutState popouts
+    readonly property var player: Players.active
+    readonly property int contentWidth: 260
+
+    function timeStr(secs: real): string {
+        if (!(secs >= 0))
+            return "--:--";
+        const h = Math.floor(secs / 3600);
+        const m = Math.floor((secs % 3600) / 60);
+        const s = Math.floor(secs % 60).toString().padStart(2, "0");
+        return h > 0 ? `${h}:${m.toString().padStart(2, "0")}:${s}` : `${m}:${s}`;
+    }
+
+    implicitWidth: contentWidth
+    implicitHeight: layout.implicitHeight
+
+    Timer {
+        running: root.player?.isPlaying ?? false
+        interval: 1000
+        repeat: true
+        triggeredOnStart: true
+        onTriggered: root.player?.positionChanged()
+    }
+
+    ColumnLayout {
+        id: layout
+
+        anchors.left: parent.left
+        anchors.right: parent.right
+        spacing: Tokens.spacing.small
+
+        CoverArt {
+            Layout.alignment: Qt.AlignHCenter
+            implicitWidth: root.contentWidth - Tokens.padding.extraLargeIncreased * 2
+            implicitHeight: implicitWidth
+        }
+
+        StyledText {
+            Layout.fillWidth: true
+            Layout.topMargin: Tokens.spacing.small
+            horizontalAlignment: Text.AlignHCenter
+            animate: true
+            text: (root.player?.trackTitle ?? "") || Tr.tr("Unknown title")
+            color: Colours.palette.m3primary
+            font: Tokens.font.title.small
+            elide: Text.ElideRight
+        }
+
+        StyledText {
+            Layout.fillWidth: true
+            horizontalAlignment: Text.AlignHCenter
+            animate: true
+            text: (root.player?.trackArtist ?? "") || Tr.tr("Unknown artist")
+            color: Colours.palette.m3secondary
+            elide: Text.ElideRight
+        }
+
+        StyledProgressBar {
+            Layout.fillWidth: true
+            Layout.topMargin: Tokens.spacing.small
+            visible: root.player?.lengthSupported ?? false
+            value: root.player?.length > 0 ? (root.player.position % root.player.length) / root.player.length : 0
+            wavy: true
+            wavePaused: !(root.player?.isPlaying ?? false)
+        }
+
+        StyledText {
+            Layout.fillWidth: true
+            visible: root.player?.lengthSupported ?? false
+            horizontalAlignment: Text.AlignHCenter
+            text: `${root.timeStr(root.player?.position ?? -1)} / ${root.timeStr(root.player?.length ?? -1)}`
+            color: Colours.palette.m3outline
+            font: Tokens.font.body.small
+        }
+
+        ButtonRow {
+            Layout.fillWidth: true
+            Layout.topMargin: Tokens.spacing.small
+            spacing: Tokens.spacing.extraSmall
+
+            IconButton {
+                type: IconButton.Tonal
+                icon: "skip_previous"
+                isRound: true
+                shapeMorph: true
+                disabled: !root.player?.canGoPrevious
+                onClicked: root.player?.previous()
+            }
+
+            IconButton {
+                fillWidth: true
+                icon: root.player?.isPlaying ? "pause" : "play_arrow"
+                isRound: true
+                shapeMorph: true
+                checked: root.player?.isPlaying ?? false
+                disabled: !root.player?.canTogglePlaying
+                onClicked: root.player?.togglePlaying()
+            }
+
+            IconButton {
+                type: IconButton.Tonal
+                icon: "skip_next"
+                isRound: true
+                shapeMorph: true
+                disabled: !root.player?.canGoNext
+                onClicked: root.player?.next()
+            }
+        }
+    }
+}
